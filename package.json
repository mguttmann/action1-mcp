{
  "name": "action1-mcp-server",
  "mcpName": "io.github.mguttmann/action1-mcp",
  "version": "0.6.1",
  "description": "Unofficial Model Context Protocol (MCP) server for the Action1 RMM REST API: curated and generated tools over the Action1 OpenAPI spec, a destructive-operation guard, stdio and Streamable HTTP transports, and an MCPB bundle. Not affiliated with Action1.",
  "license": "MIT",
  "author": "mguttmann (https://github.com/mguttmann)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mguttmann/action1-mcp.git"
  },
  "homepage": "https://github.com/mguttmann/action1-mcp#readme",
  "bugs": {
    "url": "https://github.com/mguttmann/action1-mcp/issues"
  },
  "type": "module",
  "bin": {
    "action1-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "!dist/codegen",
    "!dist/**/*.mcpb",
    "!dist/**/*.cdx.json",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc",
    "build:mcpb": "bash scripts/build-mcpb.sh",
    "prepack": "npm run clean && npm run build",
    "codegen": "tsx src/codegen/generate.ts",
    "spec:fetch": "node scripts/fetch-spec.mjs --fetch",
    "spec:check": "node scripts/fetch-spec.mjs --check",
    "live:shapes": "node scripts/live-shape-check.mjs",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "lint": "eslint src tests scripts --max-warnings 0",
    "lint:fix": "eslint src tests scripts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "test:performance": "vitest run tests/performance",
    "test:watch": "vitest",
    "inspector": "npx -y @modelcontextprotocol/inspector@2.12.0 node --env-file=.env dist/index.js",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "check": "npm run lint && npm run typecheck && npm run typecheck:tests && npm run format:check && npm test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "modelcontextprotocol",
    "action1",
    "rmm",
    "patch-management",
    "endpoint-management",
    "cve",
    "vulnerability-management",
    "claude",
    "anthropic",
    "ai-tools",
    "llm"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "express": "^4.22.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "fflate": "0.8.3",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
