{
  "name": "action1-mcp-server",
  "version": "0.5.0",
  "description": "Model Context Protocol (MCP) server for the Action1 RMM REST API — 166 tools over the full Action1 OpenAPI 3.1.0 surface, with a three-layer destructive guard, stdio and Streamable HTTP transports, and an MCPB bundle.",
  "license": "MIT",
  "author": "mguttmann (https://github.com/mguttmann)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mguttmann/action1-mcp.git"
  },
  "homepage": "https://github.com/mguttmann/action1-mcp#readme",
  "bugs": {
    "url": "https://github.com/mguttmann/action1-mcp/issues"
  },
  "type": "module",
  "bin": {
    "action1-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "build:mcpb": "bash scripts/build-mcpb.sh",
    "prepack": "npm run build && node -e \"if(require('fs').readdirSync('dist').length===0)throw new Error('dist is empty')\"",
    "codegen": "tsx src/codegen/generate.ts",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "test:performance": "vitest run tests/performance",
    "test:watch": "vitest",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js",
    "prebuild": "npm run lint && npm run typecheck && npm run test:unit"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "modelcontextprotocol",
    "action1",
    "rmm",
    "patch-management",
    "endpoint-management",
    "cve",
    "vulnerability-management",
    "claude",
    "anthropic",
    "ai-tools",
    "llm"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "tsx": "^4.22.4",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "hono": "^4.12.21"
  }
}
