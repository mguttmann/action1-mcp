# Action1 API base URL — pick your region's instance.
# Examples (do NOT commit real values):
#   https://app.eu.action1.com/api/3.0
#   https://app.action1.com/api/3.0
ACTION1_BASE_URL=

# Default organization ID. Each tool can override via `org_id` parameter.
ACTION1_ORG_ID=

# OAuth2 client credentials (issued in the Action1 console).
ACTION1_CLIENT_ID=
ACTION1_CLIENT_SECRET=

# Defaults applied to script-execution tools when the caller omits these.
ACTION1_DEFAULT_TIMEOUT_MINUTES=10
ACTION1_DEFAULT_RETRY_MINUTES=1440

# Optional: staleness threshold (minutes) for the connectivity check that
# script / reboot / execute_and_wait tools run before firing a destructive
# action. Default 10; valid range 1..1440 (24h). Raise it on networks where
# endpoints check in every 30+ minutes so a healthy endpoint is not
# mis-classified as unreachable.
ACTION1_LAST_SEEN_STALE_MINUTES=

# HTTP transport (only used when starting the server with --http).
# Leave empty to fall back to PORT=3000 / HOST=127.0.0.1.
PORT=
HOST=

# Optional: comma-separated list of allowed Origin header values for HTTP transport.
# Leave empty to allow non-browser clients (curl, MCP CLI) and reject browser
# clients whose Origin is set but not on the list.
MCP_HTTP_ALLOWED_ORIGINS=

# Optional: shared secret required as `Authorization: Bearer <token>` on every
# POST /mcp call. Strongly recommended whenever you bind --host to anything
# other than 127.0.0.1 / localhost (and hard-required for non-loopback binds
# since v0.4.0 — startup aborts otherwise).
# Minimum 16 non-whitespace characters; leading/trailing whitespace is
# stripped on both sides before the timing-safe compare.
# Recommended: 64 hex chars from `openssl rand -hex 32`.
MCP_HTTP_TOKEN=

# Optional: Express "trust proxy" setting for the HTTP transport. Only
# set this when the server sits behind a reverse proxy (nginx, Caddy,
# Cloudflare, k8s ingress) that is the ONLY ingress — otherwise clients
# can spoof X-Forwarded-For and bypass per-IP rate limits. Leave empty
# to trust no proxy (default 'false'). Accepted values:
#   false (default) | true | loopback | <integer hop count> | CIDR / IP list
TRUST_PROXY=

# Optional: log level. Syslog levels (default: info):
#   debug | info | notice | warn | warning | error | critical | alert | emergency
ACTION1_LOG_LEVEL=

# Optional: master switch for destructive tools. Without this set to
# true / 1 / yes, every destructive call is rejected even when the per-call
# confirm:"YES" + dry_run:false gates are passed.
ACTION1_ALLOW_DESTRUCTIVE=

# Optional: "auto-confirm" mode for destructive tools. When true:
#   - per-call dry_run defaults to false (was true)
#   - per-call confirm:"YES" is no longer required
# ACTION1_ALLOW_DESTRUCTIVE=true is still required as a master switch.
# Intended ONLY for isolated, single-operator test setups (e.g. a local
# Claude Desktop install). Never set this in shared / production
# deployments — it removes two of the three destructive-guard layers.
ACTION1_DESTRUCTIVE_AUTO_CONFIRM=
