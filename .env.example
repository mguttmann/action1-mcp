# Action1 API base URL: pick your region's instance.
# Examples (do NOT commit real values):
#   https://app.eu.action1.com/api/3.0     (Europe)
#   https://app.action1.com/api/3.0        (North America)
#   https://app.na-2.action1.com/api/3.0   (North America 2)
#   https://app.uk.action1.com/api/3.0     (United Kingdom)
#   https://app.au.action1.com/api/3.0     (Australia)
ACTION1_BASE_URL=

# Default organization ID. Each tool can override via `org_id` parameter.
ACTION1_ORG_ID=

# OAuth2 client credentials (issued in the Action1 console).
ACTION1_CLIENT_ID=
ACTION1_CLIENT_SECRET=

# Defaults applied to script-execution tools when the caller omits these.
ACTION1_DEFAULT_TIMEOUT_MINUTES=10
ACTION1_DEFAULT_RETRY_MINUTES=1440

# Optional: minutes since `last_seen` before an endpoint counts as offline:
# the connectivity check that script / reboot / execute_and_wait tools run
# before an action, `connectivity.online` of action1_get_endpoint and the
# fresh / stale counts of action1_endpoints_summary. Default 10; valid range
# 1..1440 (24h). Raise it on networks where endpoints check in every 30+
# minutes so a healthy endpoint is not mis-classified as unreachable.
ACTION1_LAST_SEEN_STALE_MINUTES=

# Optional: upper bound (ms) for one Action1 API call including retries and
# back-off (default 60000), and timeout (ms) for one OAuth token request
# attempt (default 15000). Valid range 1000..600000.
ACTION1_REQUEST_TIMEOUT_MS=
ACTION1_TOKEN_TIMEOUT_MS=

# HTTP transport (only used when starting the server with --http).
# Empty values fall back to the defaults: PORT=3000, HOST=127.0.0.1.
PORT=
HOST=

# Required for --http: shared secret sent as `Authorization: Bearer <token>`
# on every POST /mcp call. The server refuses to start in HTTP mode without
# it (unless MCP_HTTP_ALLOW_NO_AUTH=true, see below). Minimum 16
# non-whitespace characters; surrounding whitespace is stripped.
# Recommended: 64 hex chars from `openssl rand -hex 32`.
MCP_HTTP_TOKEN=

# Optional: set to true to run --http WITHOUT a Bearer token. Accepted only
# on a loopback bind (127.0.0.1 / localhost / ::1) and logged as a warning
# at startup. Local development only; never behind a reverse proxy.
MCP_HTTP_ALLOW_NO_AUTH=

# Optional: comma-separated Host header names to accept on top of the
# loopback names and the bind address, e.g. the public name of a reverse
# proxy (mcp.example.com). Port suffixes are ignored. Every other Host
# header is rejected with 403 (DNS-rebinding defence). Required when HOST
# is a wildcard bind (0.0.0.0 or ::).
MCP_HTTP_ALLOWED_HOSTS=

# Optional: comma-separated list of exact Origin header values to accept
# (browser clients). Empty: only loopback origins (http://localhost:<port>,
# http://127.0.0.1:<port>) are accepted. Requests without an Origin header
# (curl, MCP SDK clients) are not affected.
MCP_HTTP_ALLOWED_ORIGINS=

# Optional: Express "trust proxy" setting for the HTTP transport. Only
# set this when the server sits behind a reverse proxy (nginx, Caddy,
# Cloudflare, k8s ingress) that is the ONLY ingress, otherwise clients
# can spoof X-Forwarded-For and bypass per-IP rate limits. Leave empty
# to trust no proxy (default 'false'). Accepted values:
#   false (default) | true | loopback | <integer hop count> | CIDR / IP list
TRUST_PROXY=

# Optional: log level, case-insensitive. Syslog levels (default: info):
#   debug | info | notice | warn | warning | error | critical | alert | emergency
ACTION1_LOG_LEVEL=

# Optional: master switch for destructive tools. Without this set to
# true / 1 / yes, every destructive call is rejected even when the per-call
# confirm:"YES" + dry_run:false gates are passed.
ACTION1_ALLOW_DESTRUCTIVE=

# Optional: "auto-confirm" mode for destructive tools. When true, the
# per-call confirm:"YES" is no longer required. dry_run still defaults to
# true, so a call executes only with dry_run:false, and
# ACTION1_ALLOW_DESTRUCTIVE=true is still required as a master switch.
# Intended ONLY for isolated, single-operator test setups (e.g. a local
# Claude Desktop install). Never set this in shared / production
# deployments: it removes the per-call confirmation layer.
ACTION1_DESTRUCTIVE_AUTO_CONFIRM=

# Optional: second opt-in for account and identity operations: mutations
# of users, roles, /me, the enterprise account, organizations and
# subscriptions, and every non-GET action1_raw_request. Without this set
# to true / 1 / yes they are refused even when ACTION1_ALLOW_DESTRUCTIVE
# is on. Previews (dry_run) still work.
ACTION1_ALLOW_ACCOUNT_OPS=

# Recommended: comma-separated organization UUIDs the tools may address.
# Any other org_id (argument, resource URI, raw_request path, org ids in
# request bodies) is refused. ACTION1_ORG_ID must be on the list. Empty:
# every organization the API key can reach.
ACTION1_ALLOWED_ORG_IDS=

# Optional, only with ACTION1_ALLOWED_ORG_IDS set: also allow mutations
# that are not bound to one allowed organization (enterprise paths such
# as settings, the script library, data sources, custom reports, roles,
# users and the enterprise account, and Enterprise or Group scope
# entries). Without it they are refused. Org ids named in a request body
# are always checked against the allowlist.
ACTION1_ALLOW_ENTERPRISE_OPS=

# Optional: which tools to register. Empty or "all": every tool.
# "read": only read-only tools. "curated": only the hand-written tools
# (no generated per-operation tools). Comma-separated values combine as
# an intersection, e.g. "curated,read".
ACTION1_TOOLSETS=

# Optional: mask personal data (user names, IP and MAC addresses, other
# addresses, serial numbers, e-mail addresses, Active Directory fields,
# personal names) in tool output, resource reads and upstream error
# bodies before it reaches the LLM. Default off.
ACTION1_REDACT_PII=
